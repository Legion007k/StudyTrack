@{
    ViewData["Title"] = "Study Space";
}

<style>
    .study-space-wrapper {
        max-width: 1600px;
        margin: 0 auto;
        padding: 0 15px;
    }

    .study-space-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
        min-height: calc(100vh - 150px);
        width: 100%;
    }

    .pomodoro-section {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .pomodoro-horizontal {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        flex-wrap: wrap;
    }

    .pomodoro-timer-display {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
        text-align: center;
    }

    .pomodoro-controls-area {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        flex: 1;
        justify-content: center;
    }

    .pomodoro-controls-area #session-info {
        margin-bottom: 5px;
    }

    .pomodoro-progress-area {
        flex: 1;
        min-width: 250px;
    }

    .content-sections {
        flex: 1;
        display: flex;
        gap: 20px;
        min-height: 0;
    }

    .files-section {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #ffffff;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        min-width: 0;
    }

    .notes-section {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #ffffff;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        min-width: 0;
    }

    #timer-display {
        font-size: 3.5rem !important;
        font-weight: bold;
        color: #dc3545;
        margin: 0;
        line-height: 1;
    }

    #session-info {
        margin: 0;
    }

    #session-info {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    #session-info h4 {
        font-size: 0.95rem;
        margin: 0;
        font-weight: 600;
    }

    #session-info p {
        font-size: 0.9rem;
        margin: 0;
    }

    #session-info .separator {
        color: #dee2e6;
        font-weight: 300;
    }

    .file-viewer-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-height: 0;
    }

    .file-drop-zone {
        border: 3px dashed #dee2e6;
        border-radius: 8px;
        padding: 30px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        background: #f8f9fa;
    }

    .file-drop-zone:hover, .file-drop-zone.drag-over {
        border-color: #667eea;
        background: #f0f2ff;
    }

    .file-drop-zone i {
        font-size: 3rem;
        color: #667eea;
        margin-bottom: 10px;
    }

    .file-tabs {
        display: flex;
        gap: 5px;
        overflow-x: auto;
        padding-bottom: 5px;
        border-bottom: 2px solid #e9ecef;
    }

    .file-tab {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 6px 6px 0 0;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
        font-size: 0.85rem;
    }

    .file-tab:hover {
        background: #e9ecef;
    }

    .file-tab.active {
        background: white;
        border-bottom-color: white;
        font-weight: 600;
    }

    .file-tab .close-tab {
        color: #dc3545;
        font-weight: bold;
        margin-left: 5px;
        cursor: pointer;
    }

    .file-tab .close-tab:hover {
        color: #a71d2a;
    }

    .file-display-area {
        flex: 1;
        background: #f8f9fa;
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 0;
    }

    .file-display-area iframe {
        width: 100%;
        height: 100%;
        border: none;
    }

    .file-display-area img {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        border: none;
        object-fit: contain;
    }

    .file-display-area .text-content {
        width: 100%;
        height: 100%;
        overflow: auto;
        padding: 15px;
        background: white;
        font-family: 'Courier New', monospace;
        font-size: 0.9rem;
        white-space: pre-wrap;
        word-wrap: break-word;
    }

    .no-file-message {
        text-align: center;
        color: #6c757d;
    }

    .no-file-message i {
        font-size: 3rem;
        margin-bottom: 1rem;
        color: #dee2e6;
    }



    .section-header {
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 3px solid #dee2e6;
    }

    .section-header h2 {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 600;
    }

    .notes-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .pomodoro-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .notes-textarea {
        flex: 1;
        resize: none;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        padding: 15px;
        font-size: 1rem;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        transition: border-color 0.3s ease;
    }

    .notes-textarea:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }

    .btn-download-notes {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        padding: 12px 24px;
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .btn-download-notes:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
        color: white;
    }

    .placeholder-content {
        text-align: center;
        color: #6c757d;
    }

    .placeholder-content i {
        font-size: 3rem;
        margin-bottom: 1rem;
        color: #dee2e6;
    }

    .pomodoro-controls {
        display: flex;
        gap: 10px;
    }

    .pomodoro-controls .btn {
        padding: 8px 16px;
        font-size: 0.85rem;
        font-weight: 500;
        opacity: 0.85;
        transition: all 0.2s ease;
    }

    .pomodoro-controls .btn:hover {
        opacity: 1;
        transform: translateY(-1px);
    }

    .progress-container {
        width: 100%;
    }

    .progress {
        height: 40px !important;
        border-radius: 20px;
    }

    .progress-bar {
        border-radius: 20px;
        font-size: 0.95rem;
        font-weight: 600;
    }

    .session-info-compact {
        font-size: 0.75rem;
        color: #6c757d;
        text-align: center;
        line-height: 1.4;
    }

    /* Responsivo */
    @@media (max-width: 1200px) {
        .pomodoro-horizontal {
            flex-direction: column;
            gap: 15px;
        }

        .content-sections {
            flex-direction: column;
        }

        .files-section,
        .notes-section {
            min-height: 400px;
        }

        #timer-display {
            font-size: 2rem !important;
        }
    }
</style>

