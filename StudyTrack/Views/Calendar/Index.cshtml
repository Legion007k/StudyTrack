@model IEnumerable<Actividad>

@{
    ViewData["Title"] = "Calendario";
}

<h2>Tu Calendario</h2>

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>

<div id="calendar"></div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        var actividades = [
            @foreach (var a in Model)
            {
                    <text>
                    {
                        id: "@a.Actividad_Id",
                        title: "@a.Titulo",
                        start: "@a.FechaInicio.ToString("yyyy-MM-ddTHH:mm")",
                        end: "@a.FechaFin.ToString("yyyy-MM-ddTHH:mm")",
                        color: "@(a.Completada ? "#28a745" : "#007bff")"
                    },
                    </text>
            }
        ];

        var calendarEl = document.getElementById("calendar");
        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: "dayGridMonth",
            headerToolbar: {
                left: "prev,next today",
                center: "title",
                right: "dayGridMonth,timeGridWeek,timeGridDay"
            },
            events: actividades,
            eventClick: function(info) {
                window.location.href = "/Calendar/Editar/" + info.event.id;
            }
        });

        calendar.render();
    });
</script>

<a class="btn btn-primary mt-4" href="/Calendar/Crear">Añadir Actividad</a>
